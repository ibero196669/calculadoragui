  <property name="styleSheet">
   <string notr="true">/* QMainWindow */
QMainWindow {
    background-color: #F9FAFB;
    font-family: &quot;Segoe UI&quot;;
    font-size: 10pt;
    color: #2C3E50;
}

/* QMenuBar */
QMenuBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E3E7ED;
    padding: 4px;
}

QMenuBar::item {
    background: transparent;
    padding: 6px 12px;
    margin: 2px;
    border-radius: 6px;
    color: #2C3E50;
}

QMenuBar::item:selected {
    background-color: #EEF2F7;
}

QMenuBar::item:pressed {
    background-color: #E3E9F0;
}

/* QMenu */
QMenu {
    background-color: #FFFFFF;
    border: 1px solid #DDE3EA;
    border-radius: 8px;
    padding: 6px;
}

QMenu::item {
    padding: 6px 20px;
    border-radius: 6px;
    color: #2C3E50;
}

QMenu::item:selected {
    background-color: #3A7CA5;
    color: #FFFFFF;
}

QMenu::item:disabled {
    color: #A0A7B4;
}

/* Separador dentro del menú */
QMenu::separator {
    height: 1px;
    background: #E3E7ED;
    margin: 4px 8px;
}

/* QAction (afecta elementos del menú) */
QAction {
    padding: 6px 20px;
}</string>
