}

/* QPushButton */
QPushButton {
    background-color: #3A7CA5;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 8px 16px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #2F6690;
}

QPushButton:pressed {
    background-color: #244F73;
}

QPushButton:disabled {
    background-color: #B0BEC5;
    color: #ECEFF1;
}</string>
